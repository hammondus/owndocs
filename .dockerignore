# Anything in the build context can land in a build-stage layer on the host.
.git
.env*
data/
dist/
**/node_modules
go.work*
*.db
*.db-wal
*.db-shm
# Local build output; the image builds its own.
owndocs
runner
web/static/*
!web/static/.gitkeep
cmd/runner/runtime.js
# Served by the site container from a bind mount, never built into an image.
site/
